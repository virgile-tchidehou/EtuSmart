# ============================================================
#  EtuSmart — Fichier d'environnement (copier en .env)
#  NE JAMAIS committer le fichier .env en production !
# ============================================================

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── API Gateway ─────────────────────────────────────────────
API_GATEWAY_PORT=4000

# ── JWT (générer avec : openssl rand -hex 64) ────────────────
# IMPORTANT : Ne JAMAIS utiliser de valeur par défaut en production.
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_-hex_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=etusmart
POSTGRES_USER=etusmart_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── MinIO (stockage PDF) ─────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET_DOCUMENTS=documents
MINIO_USE_SSL=false

# ── Ollama / IA ──────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=mistral

# ── Google OAuth2 ────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── MTN MoMo (Bénin) ────────────────────────────────────────
MOMO_SUBSCRIPTION_KEY=CHANGE_ME_MOMO_KEY
MOMO_API_USER=CHANGE_ME_MOMO_USER
MOMO_API_KEY=CHANGE_ME_MOMO_API_KEY
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_ENVIRONMENT=sandbox

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=CHANGE_ME_sk_test_...
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET

# ── Email (Nodemailer) ───────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@etusmart.bj
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_FROM="EtuSmart <no-reply@etusmart.bj>"

# ── CORS ─────────────────────────────────────────────────────
# Origines autorisées (séparées par virgule)
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Logs ─────────────────────────────────────────────────────
LOG_LEVEL=info
